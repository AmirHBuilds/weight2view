# Leave unset to route requests through Vite's dev proxy (same-origin -
# required for the admin session cookie to work locally). See README.md
# "Why a dev proxy?" for the full explanation. Only set this to call a
# backend directly cross-origin.
# VITE_API_BASE_URL=http://localhost:8000

# Where the dev proxy forwards API requests to.
VITE_PROXY_TARGET=http://localhost:8000
