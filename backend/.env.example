DATABASE_URL=postgresql+psycopg2://weight2view:weight2view@localhost:5432/weight2view
APP_NAME=Weight2View API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Bootstrap Super Admin - see README.md "Admin bootstrap" for the full
# semantics. There is NO default account and NO fallback credentials.
# Leave both blank to start the app without creating any admin account
# (you can create one later directly in the database, or - once any
# super admin exists - via the Admin Panel). This only ever creates an
# account on a database that has zero super admins; it will never
# overwrite an existing account's password or create a second one.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session cookie
SESSION_COOKIE_NAME=w2v_admin_session
SESSION_LIFETIME_HOURS=168
SESSION_COOKIE_SECURE=false
