DATABASE_URL=postgresql+psycopg2://weight2view:weight2view@localhost:5432/weight2view
APP_NAME=Weight2View API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Bootstrap Super Admin - created idempotently on startup. Leave unset to
# skip creating a bootstrap account (you can still create one directly in
# the database, or via another already-existing super admin).
ADMIN_EMAIL=owner@weight2view.io
ADMIN_PASSWORD=ChangeMe123!

# Session cookie
SESSION_COOKIE_NAME=w2v_admin_session
SESSION_LIFETIME_HOURS=168
SESSION_COOKIE_SECURE=false
