# Copy this file to .env in this same directory (next to docker-compose.yml)
# before running `docker compose up`. docker compose automatically loads a
# file named exactly `.env` here for variable interpolation - this is NOT
# the same file as backend/.env, which is only read when running the
# backend directly (outside Docker).

# Bootstrap Super Admin - see README.md "Admin bootstrap" for the full
# semantics. There is NO default account and NO fallback credentials:
# leave both blank and the app starts with zero admin users until one is
# created some other way. Once any super admin exists, these variables stop
# mattering - account management from that point on happens through the
# Admin Panel, and changing these values later will NOT reset anyone's
# password or create a second super admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
